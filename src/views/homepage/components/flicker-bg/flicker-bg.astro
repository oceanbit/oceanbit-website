<canvas id="flickeringGrid" class="full" aria-hidden="true"></canvas>
<style>
  .full {
    width: 100%;
    height: 100%;
  }
</style>
<script>
  const canvas = document.getElementById("flickeringGrid") as HTMLCanvasElement;
  const squareSize = 4;
  const gridGap = 6;
  const flickerChance = 0.3;
  const color = "rgba(46,144,250,";
  let maxOpacity = 0.6;
  let isInView = false;
  let activated = false;
  const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");

  const setupCanvas = (canvas: HTMLCanvasElement) => {
    canvas.style.width = "";
    canvas.style.height = "";
    canvas.removeAttribute("height");
    canvas.removeAttribute("width");
    const canvasWidth = canvas.clientWidth;
    const canvasHeight = canvas.clientHeight;
    const dpr = window.devicePixelRatio || 1;
    canvas.width = canvasWidth * dpr;
    canvas.height = canvasHeight * dpr;
    canvas.style.width = `${canvasWidth}px`;
    canvas.style.height = `${canvasHeight}px`;
    const cols = Math.floor(canvasWidth / (squareSize + gridGap));
    const rows = Math.floor(canvasHeight / (squareSize + gridGap));

    const squares = new Float32Array(cols * rows);
    for (let i = 0; i < squares.length; i++) {
      squares[i] = Math.random() * maxOpacity;
    }

    return {
      width: canvasWidth,
      height: canvasHeight,
      cols,
      rows,
      squares,
      dpr,
    };
  };

  const ctx = canvas.getContext("2d")!;
  let animationFrameId: number | null = null;
  let { width, height, cols, rows, squares, dpr } = setupCanvas(canvas);

  const drawSquare = (index: number, clear: boolean) => {
    const x = Math.floor(index / rows) * (squareSize + gridGap) * dpr;
    const y = (index % rows) * (squareSize + gridGap) * dpr;
    const size = squareSize * dpr;
    if (clear) {
      // Include edge pixels at fractional display scales so opacity cannot build up.
      const clearX = Math.floor(x);
      const clearY = Math.floor(y);
      ctx.clearRect(
        clearX,
        clearY,
        Math.ceil(x + size) - clearX,
        Math.ceil(y + size) - clearY,
      );
    }
    ctx.fillStyle = `${color}${squares[index]})`;
    ctx.fillRect(x, y, size, size);
  };

  const drawGrid = () => {
    ctx.clearRect(0, 0, width * dpr, height * dpr);
    for (let i = 0; i < cols * rows; i++) {
      drawSquare(i, false);
    }
  };

  const updateSquares = (deltaTime: number) => {
    for (let i = 0; i < squares.length; i++) {
      if (Math.random() < flickerChance * deltaTime) {
        squares[i] = Math.random() * maxOpacity;
        // Most dots are unchanged on any frame. Preserve their pixels instead
        // of clearing and repainting the entire grid at the display refresh rate.
        drawSquare(i, true);
      }
    }
  };

  const canAnimate = () =>
    isInView && activated && !document.hidden && !motionQuery.matches;

  let lastTime: number | null = null;
  const animate = (time: number) => {
    animationFrameId = null;
    if (!canAnimate()) {
      lastTime = null;
      return;
    }

    const deltaTime = lastTime === null ? 0 : (time - lastTime) / 1000;
    lastTime = time;

    updateSquares(deltaTime);
    animationFrameId = requestAnimationFrame(animate);
  };

  const syncPlayback = () => {
    if (canAnimate()) {
      // Both observers can fire in one delivery. Only ever create one loop.
      if (animationFrameId === null) {
        animationFrameId = requestAnimationFrame(animate);
      }
    } else {
      if (animationFrameId !== null) {
        cancelAnimationFrame(animationFrameId);
        animationFrameId = null;
      }
      lastTime = null;
    }
  };

  const handleResize = () => {
    ({ width, height, cols, rows, squares, dpr } = setupCanvas(canvas));
    drawGrid();
  };

  const activationObserver = new IntersectionObserver(
    ([entry]) => {
      if (!entry!.isIntersecting) return;
      activated = true;
      maxOpacity = 0.8;
      handleResize();
      activationObserver.unobserve(canvas);
      syncPlayback();
    },
    { rootMargin: "0px 0px -50% 0px" },
  );

  const observer = new IntersectionObserver(
    ([entry]) => {
      isInView = entry!.isIntersecting;
      syncPlayback();
    },
    { threshold: 0 },
  );

  observer.observe(canvas);
  activationObserver.observe(canvas);
  drawGrid();

  window.addEventListener("resize", handleResize);
  document.addEventListener("visibilitychange", syncPlayback);
  motionQuery.addEventListener("change", syncPlayback);
</script>
